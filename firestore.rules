rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /settings/{doc=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /students/{doc=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /journal_entries/{doc=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /internal_grades/{doc=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /star_awards/{doc=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /case_records/{doc=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /pai_assessments/{doc=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /users/{doc=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /messages/{doc=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /subjects/{doc=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /learning_objectives/{doc=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /announcements/{doc=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /weekly_schedules/{doc=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
